		formatString: 0
		lineageTag: b9a5e060-938a-4662-8f3f-0ce44f5d18ed
		summarizeBy: none
		sourceColumn: customer_id

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column store_id
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 989ecc62-ece9-4028-899c-d1d5796b3138
		summarizeBy: none
		sourceColumn: store_id

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column quantity
		dataType: int64
		formatString: 0
		lineageTag: 74e3ec05-cba1-4993-bb6a-54de0a785ac0
		summarizeBy: sum
		sourceColumn: quantity

		annotation SummarizationSetBy = Automatic

