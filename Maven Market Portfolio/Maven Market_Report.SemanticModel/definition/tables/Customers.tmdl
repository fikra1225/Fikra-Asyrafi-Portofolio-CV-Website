table Customers
	excludeFromModelRefresh
	lineageTag: defdcd3d-ba66-43c5-88f0-964f1738889d

	measure 'Total Customers' = DISTINCTCOUNT(Customers[customer_id])
		formatString: 0
		lineageTag: 60c96129-5ce9-4a63-8d73-a1da17fa1b36

	measure 'Avg Age' = AVERAGE(Customers[Current Age])
		lineageTag: b1c562a8-55b7-4342-b086-e976fde849ca

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'High Priority %' = DIVIDE(CALCULATE([Total Customers], Customers[Priority]="High"), [Total Customers])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 0d0f79ed-afe9-40f7-9ff8-2f3607c7857e

	measure 'Homeowners %' = DIVIDE(CALCULATE([Total Customers], Customers[homeowner]="Y"), [Total Customers])
