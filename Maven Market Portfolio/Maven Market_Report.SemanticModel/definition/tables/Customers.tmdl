	column 'Current Age' = DATEDIFF(Customers[birthdate], TODAY(), YEAR)
		formatString: 0
		lineageTag: bfe045bf-1ada-4554-841a-b0e418bdd532
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation __PBI_SemanticLinks = [{"LinkTarget":{"TableName":"Customers","TableItemName":"Age Band","ObjectType":4},"LinkType":"UsedInGroup"}]

	column Priority = IF(Customers[homeowner] = "Y" && Customers[member_card] = "Golden", "High", "Standard")
		lineageTag: f28c21ba-6433-4d71-a461-e0bf458848d1
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Short_Country = UPPER(LEFT(Customers[customer_country], 3))
		lineageTag: a22b23a0-9c5f-49da-91ac-f24e3cfe6fca
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'House Number' = LEFT(Customers[customer_address], SEARCH(" ", Customers[customer_address]) - 1)
		lineageTag: 44586719-1ffe-44bd-8f9f-48d77c88c23f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Age Band' =
			IF(
				ISBLANK('Customers'[Current Age]),
				BLANK(),
				INT('Customers'[Current Age] / 10) * 10
			)
		formatString: 0
		lineageTag: 722a52e3-a6f5-4195-8a25-415b2240202a
		summarizeBy: none

