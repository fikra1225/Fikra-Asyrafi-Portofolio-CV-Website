<%- include("partials/header", { title: "Standings — One On One Football", active: "standings" }) %>

<main>
  <h2><%= leagueData ? leagueData.name : "League Standings" %></h2>

  <form class="controls" method="GET" action="/standings">
    <div class="field">
      <label for="league">Competition</label>
      <select name="league" id="league" onchange="this.form.submit()">
        <% leagues.forEach(function(l) { %>
          <option value="<%= l.id %>" <%= l.id === selectedLeague ? "selected" : "" %>>
            <%= l.name %> (<%= l.country %>)
          </option>
        <% }) %>
      </select>
    </div>
    <div class="field">
      <label for="season">Season</label>
      <input type="text" name="season" id="season" value="<%= selectedSeason %>" style="min-width: 90px;" />
    </div>
    <button type="submit">Update</button>
  </form>

  <% if (error) { %>
    <div class="notice"><%= error %></div>
  <% } %>

  <% if (table.length > 0) { %>
    <table>
      <thead>
        <tr>
          <th>#</th>
          <th>Team</th>
          <th>P</th>
          <th>W</th>
          <th>D</th>
          <th>L</th>
          <th>GD</th>
          <th>Pts</th>
          <th>Form</th>
        </tr>
      </thead>
      <tbody>
        <% table.forEach(function(row) { %>
          <tr>
            <td><%= row.rank %></td>
            <td>
              <div class="team-cell">
                <img src="<%= (row.team && row.team.logo) || '' %>" alt="" />
                <span><%= (row.team && row.team.name) || '' %></span>
              </div>
            </td>
            <td><%= (row.all && row.all.played) ?? 0 %></td>
            <td><%= (row.all && row.all.win) ?? 0 %></td>
            <td><%= (row.all && row.all.draw) ?? 0 %></td>
            <td><%= (row.all && row.all.lose) ?? 0 %></td>
            <td><%= row.goalsDiff ?? 0 %></td>
            <td class="pts"><%= row.points ?? 0 %></td>
            <td>
              <% (row.form || "").split("").forEach(function(letter) { %>
                <span class="form-badge form-<%= letter.toLowerCase() %>"><%= letter %></span>
              <% }) %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</main>

<%- include("partials/footer") %>
