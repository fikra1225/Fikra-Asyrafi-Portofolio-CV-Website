<%- include("partials/header", { title: "One On One Football — European Football" }) %>

<section class="hero">
  <div class="hero-inner">
    <h1>Every table, every fixture, one search away.</h1>
    <p>
      One On One Football pulls data from API-Football to show you standings,
      upcoming matches, and player and team profiles across Europe's top
      leagues.
    </p>
  </div>
</section>

<main>
  <div class="tile-grid">
    <a href="/standings" class="tile">
      <h3>League standings</h3>
      <p>Current tables for the Premier League, La Liga, Serie A, and more.</p>
    </a>
    <a href="/fixtures" class="tile">
      <h3>Fixtures &amp; live scores</h3>
      <p>See what's coming up, or check matches happening right now.</p>
    </a>
    <a href="/teams" class="tile">
      <h3>Team search</h3>
      <p>Look up a club to see its crest and recent results.</p>
    </a>
    <a href="/players" class="tile">
      <h3>Player search</h3>
      <p>Find a player and see this season's stats at a glance.</p>
    </a>
  </div>
</main>

<%- include("partials/footer") %>
