<%- include("partials/header", { title: "Team Search — One On One Football", active: "teams" }) %>

<main>
  <h2>Team Search</h2>

  <form class="controls" method="GET" action="/teams">
    <div class="field">
      <label for="name">Team name</label>
      <input type="text" name="name" id="name" placeholder="e.g. Arsenal" value="<%= query %>" />
    </div>
    <button type="submit">Search</button>
  </form>

  <% if (error) { %>
    <div class="notice"><%= error %></div>
  <% } %>

  <% if (teams.length > 0) { %>
    <div class="result-list">
      <% teams.forEach(function(t) { %>
        <div class="result">
          <img src="<%= (t.team && t.team.logo) || '' %>" alt="" />
          <div class="details">
            <h3><%= (t.team && t.team.name) || '' %></h3>
            <p>
              <%= (t.team && t.team.country) || '' %><% if (t.team && t.team.founded) { %> &middot; Founded <%= t.team.founded %><% } %>
              <% if (t.venue && t.venue.name) { %> &middot; <%= t.venue.name %><% } %>
            </p>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>

  <% if (recentFixtures.length > 0) { %>
    <h2 style="margin-top: 2.5rem;">Recent Results — <%= (teams[0] && teams[0].team && teams[0].team.name) || '' %></h2>
    <div class="fixture-list">
      <% recentFixtures.forEach(function(f) { %>
        <div class="fixture">
          <div class="side home">
            <img src="<%= (f.teams && f.teams.home && f.teams.home.logo) || '' %>" alt="" />
            <span><%= (f.teams && f.teams.home && f.teams.home.name) || '' %></span>
          </div>
          <div class="mid">
            <div class="score"><%= (f.goals && f.goals.home !== null) ? f.goals.home : '-' %> &ndash; <%= (f.goals && f.goals.away !== null) ? f.goals.away : '-' %></div>
            <div class="status">
              <%= (f.fixture && f.fixture.date) ? new Date(f.fixture.date).toLocaleDateString(undefined, { month: "short", day: "numeric", year: "numeric" }) : '' %>
            </div>
          </div>
          <div class="side away">
            <span><%= (f.teams && f.teams.away && f.teams.away.name) || '' %></span>
            <img src="<%= (f.teams && f.teams.away && f.teams.away.logo) || '' %>" alt="" />
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</main>

<%- include("partials/footer") %>
